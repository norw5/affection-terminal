  "userdoc": {
    "kind": "user",
    "methods": {
      "maxSafeLoops()": {
        "notice": "Max safe Generate() loops given the current supply (cap-aware clamp). "
      },
      "mintAndSwap(address,address,uint256,uint256,address[],uint256,uint256)": {
        "notice": "Mint AFFECTION then swap it via the PulseX V2 router, all atomically. `path` must start with AFFECTION and end with the token you want to receive (e.g. [AFFECTION, WPLS, pDAI]). `amountOutMin` protects against swap slippage; `minAffOut` protects against the mint being cap-clamped below expectations. Returns the AFFECTION minted (the swap proceeds go straight to msg.sender)."
      },
      "mintFromStable(address,address,uint256,uint256)": {
        "notice": "Full atomic route: pStable -> intermediate -> AFFECTION, in one transaction. `minOut` is the minimum AFFECTION (base units) the caller will accept — revert on slippage / cap-clamp below it. Returns the AFFECTION minted and sent to msg.sender."
      },
      "multiBuyWith(address,uint256)": {
        "notice": "Back-compatible partial route (legacy `MultiAffection.multiBuyWith` shape): the caller already holds the intermediate token. Pulls it, runs Generate() x loops + BuyWith*, and sends `loops * 3` AFFECTION to msg.sender. Cap-aware. Useful when the user minted the intermediate separately and only wants the AFFECTION leg atomic."
      }
    },
    "version": 1
  },
